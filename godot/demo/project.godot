config_version=5
[application]
config/name="PORTITOR Art Demonstration"
run/main_scene="res://demo_main.tscn"
[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=640
window/size/window_height_override=360
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.094,0.078,0.145,1)
[threading]
worker_pool/max_threads=1
[editor_plugins]
enabled=PackedStringArray("res://export/raw_plugin/plugin.cfg")
