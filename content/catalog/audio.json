{
  "format": "pushbox.catalog/1",
  "kind": "audio",
  "note": "DSN-02 声音设计规格；当前工具尚不读取 audio 目录，WB-02 实现校验/生成。条目是制作要求，不表示已生成、已确认或已进游戏。jeju_1 由 DSN-01 提供，当前以 pending_references 显式记录，不能永久豁免校验。music_set 是确认后解析到具体候选版本的稳定别名。",
  "policy": {
    "default_music_uid": "music:dungeon",
    "fallback_order": [
      "requested_set_approved_selection",
      "music:dungeon_approved_selection",
      "silence"
    ],
    "unapproved_in_game": false,
    "walking_sfx": "silent",
    "sfx_voice_limit": 3,
    "sfx_bus_gain_db": -6,
    "crossfade_ms": 1000,
    "crossfade_curve": "linear_unity_sum",
    "pause_music_gain_db": -9,
    "pause_ramp_ms": 200,
    "master_control": "workbench_monitor_only",
    "existing_game_settings": {
      "music": 0.8,
      "sfx": 0.8
    },
    "preview_defaults": {
      "master": 0.8,
      "music": 0.8,
      "sfx": 0.8
    },
    "export": {
      "sample_rate": 44100,
      "channels": 1,
      "encoding": "pcm_s16le",
      "container": "wav"
    },
    "metrics": {
      "sfx_rms_dbfs": {
        "target": -24,
        "tolerance": 2
      },
      "music_rms_dbfs": {
        "target": -26,
        "tolerance": 2
      },
      "sample_peak_max_dbfs": -9,
      "dc_abs_max": 0.001,
      "music_seam_value_delta_max": 0.002,
      "music_seam_slope_delta_max": 0.002,
      "fundamental_hz": [
        65,
        1760
      ],
      "lowpass_hz_max": 4000,
      "noise_energy_ratio_max": 0.08,
      "music_window_seconds": 3,
      "music_window_step_seconds": 1,
      "music_window_rms_range_max_db": 6,
      "music_window_ignore_below_dbfs": -50,
      "music_full_silence_max_ms": 1000,
      "sfx_endpoint_abs_max": 0.001
    },
    "sfx_duration_max_ms": 1600,
    "music_bpm_range": [
      64,
      108
    ],
    "music_meter": [
      4,
      4
    ],
    "music_bars": 32,
    "music_track_limit": 6,
    "music_pitched_voice_limit": 4,
    "note_midi_range": [
      36,
      81
    ]
  },
  "routes": {
    "delivery": {
      "slice_to_music": {
        "dungeon_1": "music:dungeon",
        "dungeon_2": "music:dungeon",
        "diyu_1": "music:diyu",
        "jeju_1": "music:jeju"
      },
      "otherwise": "slice.world_to_music_then_default"
    },
    "world_to_music": {
      "dungeon": "music:dungeon",
      "diyu": "music:diyu",
      "jeju": "music:jeju"
    },
    "chapter_to_music": {
      "dungeon": "music:dungeon",
      "ruins": "music:dungeon",
      "cave": "music:dungeon",
      "forest": "music:dungeon",
      "sky": "music:dungeon",
      "cosmos": "music:dungeon"
    },
    "group_to_chapter": {
      "basics": "dungeon",
      "water": "ruins",
      "blast": "cave",
      "react": "forest",
      "thermal": "sky",
      "experimental": "cosmos",
      "hell-pool": "dungeon"
    },
    "lobby": "visible_map_context_then_default",
    "result": "continue_current_no_restart",
    "hell": "chapter_to_music_no_diyu_name_inference"
  },
